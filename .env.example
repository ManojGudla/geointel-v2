# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (server-side only; never expose the service role key to the frontend) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (OpenRouter, free tier by default) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# OPENROUTER_MODEL is the only model setting the code reads. Left as
# openrouter/free, the server asks its own list of free models in order
# (api/_lib/ai.ts). Free models allow 50 requests a day for the whole site
# (1,000 once $10 of OpenRouter credits has been bought).
# AI_MODEL_REASONING, AI_MODEL_FAST and AI_MODEL_CHEAP are not read by the
# code: setting them changes nothing.

# --- Admin ---
# The shared passphrase for the /admin dashboard (maintenance mode) — set
# this to any long random string. Enter it once at /admin; it verifies
# against this value on every admin request (api/_lib/adminAuth.ts). Not set
# = /admin and all POSTs to /api/admin/maintenance are refused, never
# open-by-default. Required in production — do not deploy without it.
GEOINTEL_ADMIN_KEY=

# Public site URL, used for absolute links (e.g. shared location links).
PUBLIC_APP_URL=http://localhost:5173

# Google Tag Manager container id, e.g. GTM-ABC1234.
# Not a secret — it ships inside the page and anyone can read it.
# Leave this unset and the site loads no analytics and shows no consent
# banner, exactly as it behaved before analytics existed.
VITE_GTM_ID=

# Sentry error reporting in the browser, after consent. Not a secret (it
# ships inside the page). Must look like https://<key>@<host>/<project-id>,
# otherwise it is ignored. Unset = no error reporting.
VITE_SENTRY_DSN=

# Where every "Website" link about the founder points. Unset = the default
# in src/config/founder.ts (https://me.manowj.com/).
VITE_FOUNDER_SITE_URL=
