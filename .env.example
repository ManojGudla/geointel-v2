# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (server-side only; never expose the service role key to the frontend) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (OpenRouter, free tier by default) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Central model configuration — swap providers/models here, not scattered
# through the codebase. All default to the free OpenRouter model above.
AI_MODEL_REASONING=openrouter/free
AI_MODEL_FAST=openrouter/free
AI_MODEL_CHEAP=openrouter/free

# --- Admin ---
# The shared passphrase for the /admin dashboard (maintenance mode) — set
# this to any long random string. Enter it once at /admin; it verifies
# against this value on every admin request (api/_lib/adminAuth.ts). Not set
# = /admin and all POSTs to /api/admin/maintenance are refused, never
# open-by-default. Required in production — do not deploy without it.
GEOINTEL_ADMIN_KEY=

# Public site URL, used for absolute links (e.g. shared location links).
PUBLIC_APP_URL=http://localhost:5173

# Google Tag Manager container id, e.g. GTM-ABC1234.
# Not a secret — it ships inside the page and anyone can read it.
# Leave this unset and the site loads no analytics and shows no consent
# banner, exactly as it behaved before analytics existed.
VITE_GTM_ID=
