{
  "name": "geointel-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "e2e": "playwright test",
    "typecheck": "tsc -b --noEmit",
    "seed:kb": "node --env-file=.env.local scripts/seed-kb.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "flags": "npm i --no-save flag-icons && node scripts/build-flags.mjs"
  },
  "dependencies": {
    "@sentry/react": "^10.73.0",
    "@sentry/tracing": "^7.120.4",
    "@supabase/supabase-js": "^2",
    "@tanstack/react-query": "^5",
    "@turf/turf": "^7.4.0",
    "framer-motion": "^11",
    "maplibre-gl": "^4",
    "react": "^18",
    "react-dom": "^18",
    "zustand": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "jsdom": "^25",
    "typescript": "^5.6",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
