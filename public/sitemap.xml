<?xml version="1.0" encoding="UTF-8"?>
<!--
  Small on purpose, and honest about why.

  This is a single-page app with two pages worth indexing. Listing invented
  URLs to pad a sitemap does nothing except waste crawl budget on pages that
  answer 200 with the same HTML.

  /status was listed here and should not have been. Its canonical tag says
  https://www.manowj.com/ (it inherits index.html's, having no per-route
  metadata of its own), so the sitemap was asking a crawler to index a URL
  that then tells it to index a different one. A sitemap entry and a canonical
  tag that disagree is a contradiction a search engine resolves by trusting
  neither. It is a machine-readable dependency dashboard rather than a page
  anybody searches for, so it comes out of the sitemap; nothing stops it being
  reached or crawled.

  lastmod added: without it a crawler has no way to tell a page that changed
  today from one untouched for a year, and re-fetches on its own schedule.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://www.manowj.com/</loc>
    <lastmod>2026-09-13</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <!--
    The landing page. Already indexed by Google under its own title before it
    was ever listed here — which is exactly why it belongs in the sitemap: a
    URL a crawler found on its own is one it can also quietly drop.
  -->
  <url>
    <loc>https://www.manowj.com/ai-map-search</loc>
    <lastmod>2026-09-13</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
</urlset>
